# Tool versions for every CKNE lab. Proven together on Ubuntu 24.04 (EC2) on 18 Nov 2026 (job 010):
# kind cluster (1 control plane + 2 workers, no default CNI, no kube-proxy) + all of the below, pod-to-pod curl in an ambient namespace OK.
KIND_VERSION=v0.33.0
KUBERNETES_VERSION=v1.37.0        # kindest/node image used by kind v0.33.0
KUBECTL_VERSION=v1.37.1
HELM_VERSION=v4.3.1
CILIUM_VERSION=1.20.5
CILIUM_CLI_VERSION=v0.20.3
GATEWAY_API_VERSION=v1.7.0
ISTIO_VERSION=1.30.8              # newest chart in istio-release on 18 Nov 2026 (the 1.32.0 git tag has no published chart)
CERT_MANAGER_VERSION=v1.21.3
MULTUS_VERSION=v4.3.2
GIE_VERSION=v1.6.2                # Gateway API Inference Extension: InferencePool CRDs (the endpoint picker moved to llm-d)
METALLB_VERSION=v0.16.2           # comparison only (not yet tested on the box)
CNI_PLUGINS_VERSION=v1.10.0        # containernetworking/plugins reference binaries (lab 1.6 installs them onto the nodes)
FRR_IMAGE=quay.io/frrouting/frr:10.2.1  # BGP peer router for lab 3.1 (outside the cluster)
LLMD_ROUTER_VERSION=v1.0.0       # llm-d router: endpoint picker + InferencePool Helm chart (oci://ghcr.io/llm-d/charts/llm-d-router-gateway)
LLMD_SIM_IMAGE=ghcr.io/llm-d/llm-d-inference-sim:v0.7.1   # vLLM API simulator: no GPU needed
